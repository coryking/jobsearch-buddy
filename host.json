{
  "version": "2.0",
  "configurationProfile": "mcp-custom-handler",
  "customHandler": {
    "description": {
      "defaultExecutablePath": "python",
      "arguments": ["-m", "jobbuddy.mcp_server"]
    },
    "http": {
      "DefaultAuthorizationLevel": "anonymous"
    },
    "port": "8000"
  },
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": false
      }
    },
    "logLevel": {
      "default": "Warning"
    }
  }
}
