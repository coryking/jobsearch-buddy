# systemd USER oneshot service for daily jsb sync.
#
# Installed by deploy/deploy.sh — edit here, not in ~/.config/systemd/user/.
#
# This unit is static — triggered by jsb-sync.timer; do NOT enable it directly.
# Requires ~/.config/jsb-mcp.env and ~/projects/jobsearch-buddy/.venv to exist
# (see jsb-mcp.service for provisioning notes).
[Unit]
Description=Job Search Buddy sync

[Service]
Type=oneshot
WorkingDirectory=%h/projects/jobsearch-buddy
EnvironmentFile=%h/.config/jsb-mcp.env
ExecStart=%h/projects/jobsearch-buddy/.venv/bin/jsb sync
# Backstop against a wedged run. A oneshot that never exits blocks every
# subsequent timer firing (systemd won't start an already-active service),
# so a hang silently halts the daily sync until a human notices — a
# 2026-07 incident ran 10 days that way. A healthy full sync completes in
# well under an hour; anything past this is stuck, and SIGTERM'ing it is
# safe (DB-as-queue: unfinished items are still NULL and picked up next run).
RuntimeMaxSec=4h
