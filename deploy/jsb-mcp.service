# systemd USER service for the Job Search Buddy MCP server.
#
# Installed by deploy/deploy.sh — edit here, not in ~/.config/systemd/user/.
#
# Prerequisites not managed by the deploy script (provision manually once):
#   - Env file at ~/.config/jsb-mcp.env  (secrets — keep in 1Password)
[Unit]
Description=Job Search Buddy MCP server
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/projects/jobsearch-buddy
EnvironmentFile=%h/.config/jsb-mcp.env
ExecStart=%h/projects/jobsearch-buddy/.venv/bin/jsb-mcp
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
