# jobsearch-buddy environment settings
# Copy to .env and set values as needed
# All settings have defaults; only override what you need.

# Where your CSV job log and data files live
# JOBBUDDY_DATA_DIR=~/projects/resume/data

# Where to store the SQLite jobs cache (default: platform user_data_dir)
# JOBBUDDY_DB_PATH=~/.local/share/jobsearch-buddy/jobs_cache.db

# Where saved job listing markdown files are stored
# JOBBUDDY_LISTINGS_DIR=~/projects/resume/job-listings

# --- OpenAI API (enables strip, embed, and semantic search) ---
# Required for strip/embed/search. Without this, ats sync runs fetch + enrich only.
# JOBBUDDY_OPENAI_API_KEY=sk-...

# Base URL for the API. Omit for api.openai.com, set for Azure or other providers.
# JOBBUDDY_OPENAI_BASE_URL=https://your-resource.openai.azure.com/

# If set, uses AzureOpenAI client instead of standard OpenAI.
# JOBBUDDY_OPENAI_AZURE_API_VERSION=2024-12-01-preview

# Model overrides (defaults shown)
# JOBBUDDY_STRIP_MODEL=gpt-5-nano
# JOBBUDDY_EMBEDDING_MODEL=text-embedding-3-small
