# jobsearch-buddy environment settings
# Copy to .env and set values as needed
# All settings have defaults; only override what you need.

# Where your CSV job log and data files live
# JOBBUDDY_DATA_DIR=~/projects/resume/data

# Where to store the SQLite jobs cache (default: platform user_data_dir)
# JOBBUDDY_DB_PATH=~/.local/share/jobsearch-buddy/jobs_cache.db

# Where saved job listing markdown files are stored
# JOBBUDDY_LISTINGS_DIR=~/projects/resume/job-listings
